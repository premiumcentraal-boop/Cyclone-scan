<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- VPN detection (normal permission, granted at install). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- SecureWindow: hide other apps' overlays on Android 12+ (normal permission). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!--
        Package visibility for the fixed lists in DeviceSignals (root managers and
        remote-access tools). Only these packages are queried; no app inventory.
    -->
    <queries>
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="io.github.huskydg.magisk" />
        <package android:name="io.github.vvb2060.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.rifsxd.ksunext" />
        <package android:name="me.bmax.apatch" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="com.koushikdutta.superuser" />
        <package android:name="com.noshufou.android.su" />
        <package android:name="com.kingroot.kinguser" />
        <package android:name="com.thirdparty.superuser" />
        <package android:name="com.anydesk.anydeskandroid" />
        <package android:name="com.teamviewer.quicksupport.market" />
        <package android:name="com.teamviewer.teamviewer.market.mobile" />
        <package android:name="com.teamviewer.host.market" />
        <package android:name="com.carriez.flutter_hbb" />
        <package android:name="com.sand.airdroid" />
        <package android:name="com.sand.airdroidbiz" />
    </queries>
</manifest>
